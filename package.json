{
  "name": "splurt-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "source": "node scripts/source.mjs",
    "export": "node scripts/export.mjs",
