{
  "name": "splurt-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "source": "node scripts/source.mjs",
    "export": "node scripts/export.mjs",
    "prepare:data": "pnpm source && pnpm export",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-data.mjs && node scripts/package-maps.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "package:maps": "node scripts/package-maps.mjs",
    "audit:offsets": "node scripts/audit-offsets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.8.3",
    "sharp": "0.34.5",
    "vite": "7.3.1"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "jszip": "3.10.1"
  }
}
