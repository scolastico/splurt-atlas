    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "fake-indexeddb": "6.2.7",
    "sharp": "0.34.5",
    "vite": "7.3.1"
  },
  "dependencies": {
    "fuse.js": "7.5.0"
  }
}
